generator client {
  provider = "prisma-client"
  output   = "../src/lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Кэш ответов MCP Туту. Снимает риск HTTP 429 на демо и ускоряет повторные
// запросы: один и тот же поиск во время отладки не бьёт по внешнему серверу.
model McpCache {
  key       String   @id
  tool      String
  args      Json
  result    Json
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([expiresAt])
}
