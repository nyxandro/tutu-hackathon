# Подключение к Postgres из docker-compose (порт 5433, чтобы не конфликтовать с локальным)
DATABASE_URL="postgresql://tutu:tutu@localhost:5433/tutu?schema=public"

# Ключ OpenRouter — https://openrouter.ai/keys
OPENROUTER_API_KEY="sk-or-v1-..."

# Необязательно: SOCKS-прокси до Туту, если ваш адрес заблокирован
# TUTU_PROXY="socks5://127.0.0.1:1080"
